{
  "name": "qidongapp",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "ENABLE_REBOOKING": "true" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qidongapp-db",
      "database_id": "REPLACE_WITH_QIDONGAPP_DB_ID",
      "migrations_dir": "worker/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
